# --- Flask ---
SECRET_KEY=change-me-in-production
FLASK_ENV=development
PORT=5000

# --- Base de datos remota (Supabase PostgreSQL) ---
# Ejemplo: postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chordnext

# --- JWT ---
JWT_SECRET_KEY=change-me-too
JWT_ACCESS_HOURS=1
JWT_REFRESH_DAYS=30

# --- Google OAuth2 ---
# Client IDs de Google Cloud Console (web, android, ios) separados por coma.
# El backend valida el `aud` del id_token contra esta lista.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# --- CORS (coma-separado, o * en desarrollo) ---
CORS_ORIGINS=*
